{
  "name": "platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,css}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@react-native/babel-preset": "^0.85.3",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "babel-plugin-transform-flow-strip-types": "^6.22.0",
    "husky": "^9",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^15",
    "prettier": "^3.7.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-native-web": "^0.19",
    "ts-jest": "^29.4.9",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": {
    "packages": [
      "apps/*",
      "apps/mobile/*",
      "apps/web/*",
      "packages/*",
      "packages/design-system/industry/*"
    ],
    "nohoist": [
      "@app/tickets/react",
      "@app/tickets/react/**",
      "@app/tickets/react-native",
      "@app/tickets/react-native/**",
      "@app/tickets/react-dom",
      "@app/tickets/react-dom/**",
      "@app/tickets/react-native-svg",
      "@app/tickets/react-native-svg/**",
      "@app/appointmate/react",
      "@app/appointmate/react/**",
      "@app/appointmate/react-native",
      "@app/appointmate/react-native/**",
      "@app/appointmate/react-native-svg",
      "@app/appointmate/react-native-svg/**"
    ]
  },
  "dependencies": {
    "yarn": "^1.22.22"
  },
  "resolutions": {
    "react-native-safe-area-context": "~5.7.0"
  }
}
