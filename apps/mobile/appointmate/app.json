{
  "expo": {
    "name": "AppointMate",
    "slug": "appointmate",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#14161A"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14161A"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vuotto.appointmate",
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0c744a42-634a-4d07-9030-974103b99e1a"
      }
    },
    "owner": "kaduvuotto"
  }
}
