{
  "name": "@app/appointmate",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "eas-build-post-install": "cd ../../.. && yarn workspace @industry/tokens build && yarn workspace @industry/mobile build",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "start": "npx expo start --clear",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "build:android": "node scripts/bump-app-version.js && eas build --platform android --profile production",
    "build:preview": "node scripts/bump-app-version.js && eas build --platform android --profile preview",
    "build:dev": "eas build --platform android --profile development",
    "submit:android": "eas submit --platform android",
    "emulators": "firebase emulators:start --only firestore",
    "test:rules": "firebase emulators:exec --only firestore \"jest firestore.rules.test\""
  },
  "dependencies": {
    "@industry/mobile": "*",
    "@industry/tokens": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~57.0.19",
    "expo-dev-client": "~57.0.18",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "firebase": "^11.0.0",
    "react": "19.2.3",
    "react-hook-form": "^7.54.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "@repo/eslint-config": "*",
    "@testing-library/react-native": "^12",
    "@types/node": "^20",
    "@types/react": "~19.2.0",
    "react-test-renderer": "^19",
    "typescript": "~5.9.2"
  },
  "private": true
}
